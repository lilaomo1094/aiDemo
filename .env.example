# 智测 AI 自动化测试平台 - 环境变量示例
# 复制本文件为 .env 并填入真实值，.env 默认不会被提交到 git

# ========== LLM ==========
# 根据 llm.provider 选择对应的环境变量
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-...
# AZURE_OPENAI_API_KEY=...
# OLLAMA_API_KEY=...

# ========== 数据库 ==========
DATABASE_PASSWORD=your_db_password

# ========== 测试账号 ==========
TEST_PASSWORD=your_test_password

# ========== 语音识别（ASR） ==========
# 为空时自动使用 OPENAI_API_KEY
VOICE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== IM 机器人（飞书） ==========
IM_APP_SECRET=your_lark_app_secret
